#!/usr/bin/env bash
# ==============================================================================
# SonicBlueprint Pre-Commit Quality Guardrail Hook
# ==============================================================================
set -euo pipefail

echo "🔍 [Guardrail] Validating pre-commit constraints..."

# 1. Branch Protection: Disallow direct commits to main or master unless ALLOW_MAIN_COMMIT=1
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [[ ("$BRANCH" == "main" || "$BRANCH" == "master") && "${ALLOW_MAIN_COMMIT:-0}" != "1" ]]; then
  echo "❌ [Guardrail ERROR] Direct commits to '$BRANCH' are prohibited."
  echo "   Please create a feature branch first: git checkout -b feat/your-feature"
  echo "   Or export ALLOW_MAIN_COMMIT=1 for authorized release commits."
  exit 1
fi

# 2. Secret & Environment File Protection
STAGED_FILES=$(git diff --cached --name-only)
for file in $STAGED_FILES; do
  if [[ "$file" =~ (\.env|\.env\..*|\.pem|\.key|id_rsa)$ ]]; then
    echo "❌ [Guardrail ERROR] Secret file detected in staging area: $file"
    echo "   Secrets and environment files must never be committed."
    exit 1
  fi
done

# 3. Execute Master Quality Gates
echo "🏃 Running composite guardrails (typecheck, lint, sast, tests, audio-qa)..."
if npm run check:all; then
  echo "✅ [Guardrail] All verification checks passed. Commit allowed."
  exit 0
else
  echo "❌ [Guardrail ERROR] Pre-commit validation failed. Aborting commit."
  exit 1
fi
